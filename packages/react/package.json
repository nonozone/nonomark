{
  "name": "@nonoim/editor-react",
  "version": "0.3.0",
  "description": "The official React adapter for nonoMark.",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/nonozone/nonomark.git", "directory": "packages/react" },
  "files": ["dist", "src/index.d.ts", "README.md"],
  "main": "./dist/editor-react.cjs",
  "module": "./dist/editor-react.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": { "types": "./src/index.d.ts", "import": "./dist/editor-react.js", "require": "./dist/editor-react.cjs" },
    "./style.css": "./dist/editor-react.css"
  },
  "dependencies": {
    "@nonoim/editor-core": "0.3.0",
    "@tiptap/core": "3.29.0",
    "@tiptap/extension-image": "3.29.0",
    "@tiptap/extension-table": "3.29.0",
    "@tiptap/extensions": "3.29.0",
    "@tiptap/markdown": "3.29.0",
    "@tiptap/pm": "3.29.0",
    "@tiptap/react": "3.29.0",
    "@tiptap/starter-kit": "3.29.0"
  },
  "peerDependencies": { "react": "^18.2.0 || ^19.0.0", "react-dom": "^18.2.0 || ^19.0.0" },
  "sideEffects": ["**/*.css"],
  "scripts": { "build": "vite build --config vite.config.js" },
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=20.19.0" }
}
