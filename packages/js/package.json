{
  "name": "@nonoim/editor-js",
  "version": "0.6.9",
  "description": "Standalone browser Markdown editor for non-Node projects.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nonozone/nonomark.git",
    "directory": "packages/js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/editor-js.js",
  "module": "./dist/editor-js.js",
  "browser": "./dist/editor-js.js",
  "unpkg": "./dist/editor-js.iife.js",
  "jsdelivr": "./dist/editor-js.iife.js",
  "exports": {
    ".": {
      "import": "./dist/editor-js.js",
      "default": "./dist/editor-js.js"
    },
    "./dist/editor-js.iife.js": "./dist/editor-js.iife.js"
  },
  "sideEffects": false,
  "scripts": {
    "build": "vite build --config vite.config.js",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  }
}
