{
  "name": "@nonoim/editor-core",
  "version": "0.3.1",
  "description": "Framework-independent Markdown and image upload contracts for nonoMark.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nonozone/nonomark.git",
    "directory": "packages/core"
  },
  "files": ["dist", "src/index.d.ts", "src/uploadS3.d.ts", "README.md"],
  "main": "./dist/core.cjs",
  "module": "./dist/core.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./upload-s3": {
      "types": "./src/uploadS3.d.ts",
      "import": "./dist/upload-s3.js",
      "require": "./dist/upload-s3.cjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "vite build --config vite.config.js",
    "prepack": "npm run build"
  },
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=20.19.0" }
}
