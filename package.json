{
  "name": "nonomark",
  "version": "0.6.4",
  "private": true,
  "description": "nonoMark editor monorepo.",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "playground": "vite --config apps/playground/vite.config.js --host 127.0.0.1 --port 4173",
    "build:playground": "vite build --config apps/playground/vite.config.js",
    "test": "npm run test:unit && npm run test:component",
    "test:unit": "node --test test/*.test.mjs",
    "test:component": "vitest run test/*.test.js test/*.test.jsx",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm test && npm run typecheck && npm run build && npm run build:playground"
  },
  "devDependencies": {
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-image": "3.29.2",
    "@tiptap/extension-table": "3.29.2",
    "@tiptap/markdown": "3.29.2",
    "@tiptap/react": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^29.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.1",
    "vitest": "^4.1.10",
    "vue": "^3.5.39"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
